# Copy to .env for local development. Replace placeholders locally; never commit .env.
# Production secrets must be injected from the deployment secret store.

APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-local-secret
JWT_SIGNING_KEY=replace-with-a-random-local-signing-key
JWT_ISSUER=ifss-local
JWT_AUDIENCE=ifss-api
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ifss
MYSQL_USER=ifss_local_user
MYSQL_PASSWORD=replace-with-local-only-password
MYSQL_ROOT_PASSWORD=replace-with-local-only-root-password

# Three separate MinIO service instances; all may share one development host.
MINIO_NODE_1_ENDPOINT=http://localhost:9001
MINIO_NODE_1_ACCESS_KEY=replace-with-node-1-local-access-key
MINIO_NODE_1_SECRET_KEY=replace-with-node-1-local-secret-key
MINIO_NODE_2_ENDPOINT=http://localhost:9002
MINIO_NODE_2_ACCESS_KEY=replace-with-node-2-local-access-key
MINIO_NODE_2_SECRET_KEY=replace-with-node-2-local-secret-key
MINIO_NODE_3_ENDPOINT=http://localhost:9003
MINIO_NODE_3_ACCESS_KEY=replace-with-node-3-local-access-key
MINIO_NODE_3_SECRET_KEY=replace-with-node-3-local-secret-key
MINIO_BUCKET=ifss-private
REPLICATION_FACTOR=3
UPLOAD_COMMIT_MIN_REPLICAS=2

OPENAI_API_KEY=replace-with-your-own-key-or-leave-empty
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=replace-with-approved-chat-model

MAX_FILE_SIZE_BYTES=1073741824
USER_STORAGE_QUOTA_BYTES=10737418240
MAX_FILES_PER_USER=10000
